<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Lynn's playground: selected experiments and earlier design work."
    />
    <title>Playground — Lynn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist+Pixel&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Noto+Sans+SC:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/fonts.css?v=20260729-1" />
    <link rel="stylesheet" href="/case-nav.css?v=20260728-3" />
    <link rel="stylesheet" href="/footer-strip.css?v=20260729-shared-footer-3" />
  </head>
  <body>
    <div class="ui case-nav-ui playground-nav-ui">
      <nav class="site-nav" aria-label="Primary">
        <a class="logo" href="/">
          <span class="logo__mark" aria-hidden="true"></span>
          <span>Lynn</span>
        </a>
        <div class="nav-links">
          <a href="/#work">Work</a>
          <a href="/about/">About</a>
        </div>
      </nav>
    </div>

    <main class="playground-page">
      <section class="playground-artwork" aria-labelledby="playground-instructions">
        <p class="visually-hidden" id="playground-instructions">
          Drag in any direction, use a mouse wheel or trackpad, or focus the
          canvas and use the arrow keys to explore. Press Home to return to the
          starting position.
        </p>
        <ul class="visually-hidden" aria-label="Projects shown in the playground">
          {
            projects.map((project) => (
              <li>{project.title}, {project.year}</li>
            ))
          }
        </ul>

        <div
          class="playground-stage"
          data-pan-surface
          tabindex="0"
          role="region"
          aria-label="Scrollable and draggable playground project canvas"
          aria-describedby="playground-instructions"
        >
          <div class="playground-world" data-pan-world aria-hidden="true">
            <div class="playground-tile" data-world-tile>
              {
                projects.map((project) => (
                  <article
                    class="project-card"
                    data-node-id={project.nodeId}
                    style={`--card-x:${project.x}px;--card-y:${project.y}px;--card-width:${project.width}px;--preview-height:${project.previewHeight}px;--copy-width:${project.copyWidth}px;--year-color:${project.accent};--image-width:${project.imageWidth};--image-height:${project.imageHeight};--image-left:${project.imageLeft};--image-top:${project.imageTop};`}
                  >
                    <div class="project-preview">
                      <picture>
                        <source
                          srcset={`/assets/playground/${project.file}.webp`}
                          type="image/webp"
                        />
                        <img
                          class="project-image"
                          src={`/assets/playground/${project.file}.png`}
                          alt=""
                          draggable="false"
                          decoding="async"
                        />
                      </picture>
                    </div>
                    <div class="project-copy">
                      <h2>{project.title}</h2>
                      <p>{project.year}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </div>

          <div class="stage-overlay" aria-hidden="true">
            <div class="stage-fade"></div>
            <div class="movement-hint">
              <span class="movement-icon">
                <img
                  src="/assets/playground/pan-icon.svg"
                  width="28"
                  height="28"
                  alt=""
                  draggable="false"
                />
              </span>
              <span>scroll / drag to move</span>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer site-footer--shared">
      <div class="pixel-footer-scene">
        <canvas
          id="scene"
          width="2048"
          height="447"
          aria-hidden="true"
        ></canvas>
        <div class="footer-meta">
          <span class="footer-year">© 2026</span>
          <p class="footer-copy">
            crafted with
            <span class="footer-love-mark" role="img" aria-label="love"></span>
            &amp; made with AI by Lynn
          </p>
        </div>
      </div>
    </footer>

    <script>
      import "../../scripts/playground.js";
    </script>
    <script src="/footer-canvas.js?v=20260729-shared-footer-1" defer></script>
    <script src="/footer-strip-crop.js?v=20260729-ground-only-1" defer></script>
  </body>
</html>
